{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tracevision-app",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "tracevision.api"
      ],
      "port": 8000
    },
    {
      "name": "tracevision-ui-only",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "tracevision.api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "env": {
        "TRACEVISION_UI_ONLY": "1"
      },
      "port": 8010
    }
  ]
}
