# Raw data, frames, crops and model weights stay local (size, licences, real plates)
TRACEVISION_DATA/raw/**
!TRACEVISION_DATA/raw/**/
!TRACEVISION_DATA/raw/**/.gitkeep
TRACEVISION_DATA/processed/test_video_frames/**
TRACEVISION_DATA/processed/plate_crops/**
TRACEVISION_DATA/models/weights/
*.pt
*.pth
*.safetensors
*.onnx
*.mp4
*.avi
*.mov
*.mkv
__pycache__/
*.pyc
.env
.venv/
# OCR eval crops + plate-text ground truth (real plates, source licence unstated) - rebuild with build_ocr_eval_set.py
TRACEVISION_DATA/processed/ocr_evaluation/*/crops/
TRACEVISION_DATA/processed/ocr_evaluation/*/ground_truth.csv
