# Raw data stays local by default; the datasets the team needs are un-ignored below
TRACEVISION_DATA/raw/**
!TRACEVISION_DATA/raw/**/
!TRACEVISION_DATA/raw/**/.gitkeep
# Shared with the team (decided 2026-11-22): Quobotic v3 plate detection + zenitsu09 OCR parquet
!TRACEVISION_DATA/raw/plate_detection/**
!TRACEVISION_DATA/raw/ocr_corpus/zenitsu09/**
# Rejected synthetic b8iqo set stays local
TRACEVISION_DATA/raw/_rejected/
TRACEVISION_DATA/processed/test_video_frames/**
!TRACEVISION_DATA/processed/test_video_frames/.gitkeep
TRACEVISION_DATA/processed/plate_crops/**
!TRACEVISION_DATA/processed/plate_crops/.gitkeep
TRACEVISION_DATA/models/weights/
*.pt
*.pth
*.onnx
# Model weights: only the Awiros OCR weights are shared (Apache-2.0, via Git LFS)
*.safetensors
!TRACEVISION_DATA/models/awiros/model.safetensors
*.mp4
*.avi
*.mov
*.mkv
# Model-card sample plate images
TRACEVISION_DATA/models/awiros/samples/
__pycache__/
*.pyc
.env
.venv/
# Test clips shared with the team for labelling (2026-11-23): own footage clip01-09 via Git LFS.
# clip10-11 are Pexels stock: NOT re-hosted (Pexels licence); download them from the links in evaluation/clips.csv.
!TRACEVISION_DATA/raw/test_videos/
!TRACEVISION_DATA/raw/test_videos/*
!TRACEVISION_DATA/raw/test_videos/clip0[1-9].mp4
TRACEVISION_DATA/raw/test_videos/clip1[0-9].mp4
# Labelling aids: contact sheets + frame index (frames themselves are regenerated with extract_test_video_frames.py)
!TRACEVISION_DATA/processed/test_video_frames/**/
!TRACEVISION_DATA/processed/test_video_frames/*/contact_sheet_fps2.jpg
!TRACEVISION_DATA/processed/test_video_frames/frames_index.csv
!TRACEVISION_DATA/processed/test_video_frames/clips_meta.json
# Training runs (weights and plots): only the report is shared
TRACEVISION_DATA/models/plate_detector_runs/
# Our fine-tuned plate detector is shared with the team (Git LFS, 6.5 MB)
!TRACEVISION_DATA/models/weights/
TRACEVISION_DATA/models/weights/*
!TRACEVISION_DATA/models/weights/plate_yolov8n_quobotic.pt
